            I_Contact( "Run" )
            PBox( "EdgeStart" )
            Coil( "CmdStart" )
        END_RUNG
        RUNG wire#powerrail
            Contact( "DB_HMI_Interface".HmiStart )
        END_RUNG wire#w1
    END_NETWORK

    {
      S7_Language := "LAD"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "CmdStart" )
            S_Coil( "Run" )
        END_RUNG
    END_NETWORK

