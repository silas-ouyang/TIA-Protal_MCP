{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
ORGANIZATION_BLOCK "Main"

    {
      S7_Language := "LAD"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "SB1_Start" )
